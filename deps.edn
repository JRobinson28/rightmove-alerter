{:paths ["src"]
 :deps {cheshire/cheshire {:mvn/version "6.2.0"}
        clj-http/clj-http {:mvn/version "3.13.1"}
        com.amazonaws/aws-lambda-java-core {:mvn/version "1.4.0"}
        com.cognitect.aws/api {:mvn/version "0.8.847"}
        com.cognitect.aws/dynamodb {:mvn/version "871.2.51.4"}
        com.cognitect.aws/endpoints {:mvn/version "871.2.54.18"}
        com.cognitect.aws/sns {:mvn/version "871.2.55.2"}
        com.taoensso/timbre {:mvn/version "6.8.0"}
        org.clj-commons/hickory {:mvn/version "0.7.7"}
        org.clojure/clojure {:mvn/version "1.12.6"}
        org.clojure/tools.cli {:mvn/version "1.4.256"}}
 :aliases {:run {:main-opts ["-m" "rightmove-alerter.cli"]}
           :build {:deps {io.github.clojure/tools.build {:git/tag "v0.10.14" :git/sha "9d08b2a"}
                          org.clojure/clojure {:mvn/version "1.12.6"}}
                   :ns-default build}
           :test {:extra-paths ["test" "test/resources"]
                  :extra-deps {clj-http-fake/clj-http-fake {:mvn/version "1.0.4"}
                               org.clojure/test.check {:mvn/version "1.1.3"}
                               io.github.cognitect-labs/test-runner
                               {:git/tag "v0.5.1" :git/sha "5e91ee0"}}
                  :main-opts ["-m" "cognitect.test-runner"]
                  :exec-fn cognitect.test-runner.api/test}
           :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.08.04"}}
                  :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test" "build.clj"]}
           :fmt {:replace-deps {dev.weavejester/cljfmt {:mvn/version "0.16.6"}}
                 :main-opts ["-m" "cljfmt.main"]}
           :outdated {:replace-deps {com.github.liquidz/antq {:mvn/version "2.11.1276"}}
                      :main-opts ["-m" "antq.core"]}}}
